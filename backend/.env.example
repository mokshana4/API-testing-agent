# ---- LLM (optional) ----------------------------------------------------
# Without a key the agent still works using its rule-based engine.
# Provider is auto-detected from whichever key is set; or force it:
# LLM_PROVIDER=anthropic   # anthropic | openai | none

ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5

# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, Ollama...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local Ollama example:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
